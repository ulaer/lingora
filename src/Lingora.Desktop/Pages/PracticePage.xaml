<UserControl x:Class="Lingora.Desktop.Pages.PracticePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="64,40,64,40" MaxWidth="820">
            <StackPanel>
                <!-- Çevrilecek cümle -->
                <TextBlock x:Name="SourceCaption" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Opacity="0.75" Margin="0,0,0,8" />
                <TextBox x:Name="SourceText" Style="{StaticResource ReadOnlyText}"
                         FontSize="30" FontWeight="Light" Foreground="White" />
                <Button x:Name="LoadDataButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        Foreground="{StaticResource AccentBrush}" Content="Veri dosyası yükle →"
                        Visibility="Collapsed" Click="OnLoadDataClick" Margin="-6,8,0,0" />

                <!-- Çeviri alanı: çerçevesiz, şeffaf -->
                <Grid Margin="0,44,0,0">
                    <TextBox x:Name="InputBox" Style="{StaticResource GhostInput}" FontSize="21" FontWeight="Light"
                             Foreground="#DCE6F5" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="False"
                             SpellCheck.IsEnabled="False"
                             PreviewKeyDown="OnInputPreviewKeyDown" TextChanged="OnInputTextChanged" />
                    <TextBlock x:Name="Placeholder" FontSize="21" FontWeight="Light" IsHitTestVisible="False"
                               Foreground="{StaticResource TextMutedBrush}" Opacity="0.5" Margin="2,0,0,0" />
                </Grid>

                <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Gönder"
                        MinWidth="130" HorizontalAlignment="Left" Margin="0,24,0,0" Click="OnSendClick" />

                <!-- Cevap beklenirken yalnızca dönen noktalar -->
                <TextBlock x:Name="ThinkingText" FontSize="30" FontWeight="Light" Margin="2,22,0,0"
                           Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed" />

                <!-- Sonuç: zemin yok, ince bir ayırıcı çizgi -->
                <Border x:Name="ResultPanel" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                        Padding="0,26,0,0" Margin="0,32,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultHeadline" FontSize="22" FontWeight="Light"
                                   TextWrapping="Wrap" Margin="0,0,0,20" />
                        <StackPanel x:Name="ResultBody" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
