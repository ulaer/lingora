<UserControl x:Class="Lingora.Desktop.Pages.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="Caption2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Başlık + mod -->
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Oyun" FontSize="26" FontWeight="Light" Foreground="White" />
                <TextBlock x:Name="ScoreText" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <!-- Seviye -->
                <Border Background="{StaticResource GlassBrush}" CornerRadius="8" Padding="3" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LevelA1" GroupName="GameLevel" Style="{StaticResource SegmentButton}"
                                     Content="A1" ToolTip="A1 · Şimdiki zaman: kim ne yapıyor" Checked="OnLevelChecked" />
                        <RadioButton x:Name="LevelA2" GroupName="GameLevel" Style="{StaticResource SegmentButton}"
                                     Content="A2" ToolTip="A2 · Zaman, olumsuz, soru, duygu, hava" Checked="OnLevelChecked" />
                        <RadioButton x:Name="LevelB1" GroupName="GameLevel" Style="{StaticResource SegmentButton}"
                                     Content="B1" ToolTip="B1 · Konuşma, düşünce, durum değişimi, sıralı olay" Checked="OnLevelChecked" />
                    </StackPanel>
                </Border>
                <!-- Hangi dilde anlatılacak -->
                <Border Background="{StaticResource GlassBrush}" CornerRadius="8" Padding="3" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangEnglish" GroupName="GameLang" Style="{StaticResource SegmentButton}"
                                     Content="İngilizce" ToolTip="Resmi İngilizce anlat" Checked="OnLanguageChecked" />
                        <RadioButton x:Name="LangTurkish" GroupName="GameLang" Style="{StaticResource SegmentButton}"
                                     Content="Türkçe" ToolTip="Resmi Türkçe anlat" Checked="OnLanguageChecked" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource GlassBrush}" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeDescribe" GroupName="GameMode" Style="{StaticResource SegmentButton}"
                                     Content="Resmi anlat" IsChecked="True" Checked="OnModeChecked" />
                        <RadioButton x:Name="ModeChoose" GroupName="GameMode" Style="{StaticResource SegmentButton}"
                                     Content="Doğru cümleyi seç" Checked="OnModeChecked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="MissingText" Grid.Row="1" Style="{StaticResource Body}" FontSize="15" Visibility="Collapsed"
                   Foreground="{StaticResource WarnBrush}" />

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sahne -->
                    <StackPanel>
                        <Border x:Name="SceneFrame" Width="340" Height="340" CornerRadius="18" ClipToBounds="True"
                                Background="{StaticResource GlassBrush}">
                            <Image x:Name="SceneImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock x:Name="HintText" Style="{StaticResource Muted}" FontSize="13" Margin="4,10,0,0" />
                    </StackPanel>

                    <!-- Resmi anlat -->
                    <StackPanel x:Name="DescribePanel" Grid.Column="1" Margin="32,4,0,0">
                        <TextBlock x:Name="DescribeCaption" Style="{StaticResource Caption2}" />
                        <Grid Margin="0,18,0,0">
                            <TextBox x:Name="InputBox" Style="{StaticResource GhostInput}" FontSize="21" FontWeight="Light"
                                     Foreground="#DCE6F5" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="False"
                                     SpellCheck.IsEnabled="False" PreviewKeyDown="OnInputPreviewKeyDown"
                                     TextChanged="OnInputTextChanged" />
                            <TextBlock x:Name="Placeholder" FontSize="21" FontWeight="Light" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMutedBrush}" Opacity="0.5" Margin="2,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                        <WrapPanel Margin="0,20,0,0">
                            <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Gönder" MinWidth="130"
                                    Click="OnSendClick" Margin="0,0,10,0" />
                            <Button x:Name="NextSceneButton" Style="{StaticResource LinkButton}" Content="Başka resim →"
                                    Click="OnNextSceneClick" />
                        </WrapPanel>
                        <TextBlock x:Name="ThinkingText" FontSize="30" FontWeight="Light" Margin="2,18,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Doğru cümleyi seç -->
                    <StackPanel x:Name="ChoosePanel" Grid.Column="1" Margin="32,4,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ChooseCaption" Style="{StaticResource Caption2}" Margin="0,0,0,16" />
                        <StackPanel x:Name="OptionsPanel" />
                        <TextBlock x:Name="ChoiceFeedback" Style="{StaticResource Body}" FontSize="15" Margin="2,6,0,0" />
                        <WrapPanel Margin="0,16,0,0">
                            <Button x:Name="NextChoiceButton" Style="{StaticResource PrimaryButton}" Content="Sonraki resim"
                                    MinWidth="130" Click="OnNextChoiceClick" Visibility="Collapsed" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- Resmi anlat sonucu: ana ekrandaki gibi zemin yok -->
                <Border x:Name="ResultPanel" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0"
                        Padding="0,24,0,0" Margin="0,28,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultHeadline" FontSize="22" FontWeight="Light" TextWrapping="Wrap" Margin="0,0,0,18" />
                        <StackPanel x:Name="ResultBody" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
