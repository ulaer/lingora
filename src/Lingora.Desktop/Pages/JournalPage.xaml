<UserControl x:Class="Lingora.Desktop.Pages.JournalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DayButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="12,9"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GlassBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GlassBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Günler -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Günlük" FontSize="26" FontWeight="Light" Foreground="White" Margin="0,0,0,16" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="DayList" />
            </ScrollViewer>
        </DockPanel>

        <!-- Seçili gün -->
        <DockPanel Grid.Column="1" Margin="28,4,0,0">
            <StackPanel DockPanel.Dock="Top">
                <Grid>
                    <TextBlock x:Name="DayTitle" FontSize="22" FontWeight="Light" Foreground="White" VerticalAlignment="Bottom" />
                    <Border HorizontalAlignment="Right" Background="{StaticResource GlassBrush}" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabLesson" GroupName="JournalTab" Style="{StaticResource SegmentButton}"
                                         Content="Ders notu" IsChecked="True" Checked="OnTabChecked" />
                            <RadioButton x:Name="TabAudio" GroupName="JournalTab" Style="{StaticResource SegmentButton}"
                                         Content="Sesli ders" Checked="OnTabChecked" />
                            <RadioButton x:Name="TabRecords" GroupName="JournalTab" Style="{StaticResource SegmentButton}"
                                         Content="Hatalar ve ipuçları" Checked="OnTabChecked" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="DayStats" Style="{StaticResource Muted}" Margin="0,6,0,14" />
            </StackPanel>

            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid Margin="0,0,14,0">
                    <!-- Ders notu -->
                    <StackPanel x:Name="LessonPanel">
                        <StackPanel x:Name="LessonEmpty">
                            <TextBlock x:Name="LessonIntro" Style="{StaticResource Body}" FontSize="15"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="CreateLessonButton" Style="{StaticResource PrimaryButton}"
                                        Content="Ders notunu oluştur" Click="OnCreateLessonClick" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock x:Name="LessonStatus" Style="{StaticResource Body}" Margin="0,14,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="LessonContent" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Sesli ders: yalnızca metin anlatım + MP3 -->
                    <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
                        <StackPanel x:Name="AudioEmpty">
                            <TextBlock x:Name="AudioIntro" Style="{StaticResource Body}" FontSize="15"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button x:Name="CreateAudioButton" Style="{StaticResource PrimaryButton}"
                                        Content="Sesli dersi oluştur" Click="OnCreateAudioClick" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock x:Name="AudioStatus" Style="{StaticResource Body}" Margin="0,14,0,0" Visibility="Collapsed" />

                        <StackPanel x:Name="AudioContent" Visibility="Collapsed">
                            <!-- Oynatıcı -->
                            <Border Background="{StaticResource GlassBrush}" CornerRadius="14" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Click="OnPlayClick"
                                            ToolTip="Dinle">
                                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="16" Foreground="White" />
                                    </Button>
                                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AudioTitle" FontSize="15" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,8,0,0" Height="4">
                                            <Border Background="#22FFFFFF" CornerRadius="2" />
                                            <Border x:Name="AudioProgressFill" Background="{StaticResource LogoGradient}" CornerRadius="2"
                                                    HorizontalAlignment="Left" Width="0" />
                                        </Grid>
                                        <TextBlock x:Name="AudioTime" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button x:Name="SaveMp3Button" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                            Content="MP3 olarak kaydet" VerticalAlignment="Center" Click="OnSaveMp3Click" />
                                </Grid>
                            </Border>

                            <TextBlock Text="ANLATIM METNİ" Style="{StaticResource SectionLabel}" />
                            <TextBox x:Name="AudioScriptText" Style="{StaticResource ReadOnlyText}" FontSize="15" />
                            <TextBlock x:Name="AudioMeta" Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,6" />
                            <Button x:Name="RegenerateAudioButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Margin="0,6,0,6" Visibility="Collapsed" Click="OnRegenerateAudioClick" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Günün kayıtları -->
                    <StackPanel x:Name="RecordsPanel" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
