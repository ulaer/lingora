<UserControl x:Class="Lingora.Desktop.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,30,40,30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Ayarlar" Margin="0,0,0,18" />
            <RadioButton x:Name="TabApi" GroupName="SettingsTabs" Style="{StaticResource SideTab}"
                         Content="API Anahtarı" Checked="OnTabChecked" />
            <RadioButton x:Name="TabData" GroupName="SettingsTabs" Style="{StaticResource SideTab}"
                         Content="Veri Dosyası (TXT)" Checked="OnTabChecked" />
            <RadioButton x:Name="TabGeneral" GroupName="SettingsTabs" Style="{StaticResource SideTab}"
                         Content="Genel" Checked="OnTabChecked" />
            <RadioButton x:Name="TabCheck" GroupName="SettingsTabs" Style="{StaticResource SideTab}"
                         Content="Sistem Kontrolü" Checked="OnTabChecked" />
        </StackPanel>

        <ScrollViewer Grid.Column="1" Margin="32,52,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,16,0">

                <!-- API anahtarı -->
                <StackPanel x:Name="ApiPanel">
                    <DockPanel>
                        <Button x:Name="ApiHelpButton" DockPanel.Dock="Right" Style="{StaticResource HelpButton}"
                                Content="Nasıl yapılır?" ToolTip="API anahtarı nasıl alınır?" Click="OnHelpClick" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="API Anahtarı" />
                    </DockPanel>
                    <Border x:Name="ApiHelpPanel" Style="{StaticResource HelpPanel}" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Google AI Studio'dan aldığınız Gemini API anahtarını girin. Anahtar koda gömülmez; bu bilgisayarda Windows DPAPI ile şifrelenerek saklanır ve yalnızca sizin Windows kullanıcınız çözebilir." />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                        <Run Text="Anahtar almak için:" />
                        <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="OnHyperlink">aistudio.google.com/apikey</Hyperlink>
                    </TextBlock>

                    <TextBlock Style="{StaticResource FieldCaption}" Text="KAYITLI ANAHTAR" />
                    <TextBlock x:Name="CurrentKeyText" Style="{StaticResource Body}" />

                    <TextBlock Style="{StaticResource FieldCaption}" Text="YENİ ANAHTAR" />
                    <PasswordBox x:Name="KeyBox" />

                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="SaveKeyButton" Style="{StaticResource PrimaryButton}" Content="Kaydet"
                                Click="OnSaveKey" Margin="0,0,10,0" />
                        <Button x:Name="TestKeyButton" Style="{StaticResource SecondaryButton}" Content="Bağlantıyı test et"
                                Click="OnTestKey" Margin="0,0,10,0" />
                        <Button x:Name="ClearKeyButton" Style="{StaticResource LinkButton}" Content="Anahtarı sil"
                                Click="OnClearKey" />
                    </WrapPanel>
                    <TextBlock x:Name="ApiStatus" Style="{StaticResource Status}" />
                </StackPanel>

                <!-- Veri dosyası -->
                <StackPanel x:Name="DataPanel" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="DataHelpButton" DockPanel.Dock="Right" Style="{StaticResource HelpButton}"
                                Content="Nasıl yapılır?" ToolTip="Cümle dosyası nereden bulunur?" Click="OnHelpClick" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Veri Dosyası (TXT)" />
                    </DockPanel>
                    <Border x:Name="DataHelpPanel" Style="{StaticResource HelpPanel}" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Tatoeba / manythings.org biçimindeki cümle dosyasını yükleyin (ör. tur.txt). Her satır sekmeyle ayrılmış üç sütundan oluşur: İngilizce, Türkçe ve kaynak bilgisi (isteğe bağlı)." />
                    <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,12,0,0">
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Hi.  ⇥  Merhaba.  ⇥  CC-BY 2.0 (France) Attribution: tatoeba.org ..." />
                    </Border>

                    <TextBlock Style="{StaticResource FieldCaption}" Text="ŞU AN YÜKLÜ" />
                    <TextBlock x:Name="CorpusInfo" Style="{StaticResource Body}" />

                    <TextBlock Style="{StaticResource FieldCaption}" Text="DOSYA" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" />
                        <Button Grid.Column="1" x:Name="BrowseButton" Style="{StaticResource SecondaryButton}"
                                Content="Gözat…" Margin="10,0,0,0" Click="OnBrowse" />
                    </Grid>

                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="Yükle" Click="OnImport" />
                    </WrapPanel>
                    <TextBlock x:Name="ImportStatus" Style="{StaticResource Status}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,18,0,0"
                               Text="Yeni dosya yüklendiğinde cümle havuzu değişir; ilerleme kaydınız silinmez. Cümle verisi: Tatoeba (CC-BY 2.0 FR)." />
                </StackPanel>

                <!-- Genel -->
                <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Genel" />

                    <TextBlock Style="{StaticResource FieldCaption}" Text="GÜNLÜK HEDEF" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="GoalBox" Width="90" />
                        <TextBlock x:Name="GoalHint" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldCaption}" Text="ZORLUK (İNGİLİZCE CÜMLENİN KELİME SAYISI)" />
                    <StackPanel x:Name="DifficultyOptions" />

                    <TextBlock Style="{StaticResource FieldCaption}" Text="SIRA" />
                    <RadioButton x:Name="OrderSequential" GroupName="Order" Style="{StaticResource Option}"
                                 Content="Baştan sona (dosyadaki sırayla, kolaydan zora)" />
                    <RadioButton x:Name="OrderRandom" GroupName="Order" Style="{StaticResource Option}"
                                 Content="Rastgele" />

                    <TextBlock Style="{StaticResource FieldCaption}" Text="BAŞLANGIÇ SATIRI" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="StartLineBox" Width="130" />
                        <Button x:Name="StartLineButton" Style="{StaticResource SecondaryButton}"
                                Content="Bu satırdan başla" Margin="10,0,0,0" Click="OnStartLine" />
                    </StackPanel>
                    <TextBlock x:Name="PositionInfo" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    <TextBlock x:Name="StartLineStatus" Style="{StaticResource Status}" Margin="0,8,0,0" />

                    <TextBlock Style="{StaticResource FieldCaption}" Text="GEMINI MODELİ" />
                    <TextBox x:Name="ModelBox" />
                    <TextBlock x:Name="ModelHint" Style="{StaticResource Muted}" Margin="0,8,0,0" />

                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="SaveGeneralButton" Style="{StaticResource PrimaryButton}" Content="Kaydet" Click="OnSaveGeneral" />
                    </WrapPanel>
                    <TextBlock x:Name="GeneralStatus" Style="{StaticResource Status}" />
                </StackPanel>

                <!-- Sistem kontrolü -->
                <StackPanel x:Name="CheckPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Sistem Kontrolü" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Kurulumun bu bilgisayarda çalıştığını denetler: veri klasörü, ayarlar, cümle dosyası, ilerleme kaydı ve API anahtarı." />
                    <CheckBox x:Name="LiveCheckBox" Content="Gemini'ye gerçek bir test isteği de gönder" Margin="0,16,0,0" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="RunCheckButton" Style="{StaticResource PrimaryButton}" Content="Kontrolü çalıştır" Click="OnRunCheck" />
                    </WrapPanel>
                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                        <TextBox x:Name="CheckOutput" Style="{StaticResource ReadOnlyText}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13"
                                 Text="Henüz çalıştırılmadı." />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
