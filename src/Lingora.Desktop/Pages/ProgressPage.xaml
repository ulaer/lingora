<UserControl x:Class="Lingora.Desktop.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="40,34,40,34">

            <!-- Bugün -->
            <TextBlock Text="BUGÜN" Style="{StaticResource Caption}" Opacity="0.85" />
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock x:Name="TodayCount" FontSize="56" FontWeight="Light" Foreground="White" />
                    <TextBlock x:Name="GoalText" FontSize="22" FontWeight="Light" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Bottom" Margin="8,0,0,10" />
                </StackPanel>
                <TextBlock x:Name="RemainingText" Grid.Column="1" FontSize="15" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Margin="0,0,0,12" />
            </Grid>

            <!-- İnce ilerleme çubuğu -->
            <Grid x:Name="Bar" Height="6" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BarFilled" Width="0*" />
                    <ColumnDefinition x:Name="BarRest" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{StaticResource GlassBrush}" />
                <Border CornerRadius="3" Background="{StaticResource LogoGradient}" />
            </Grid>

            <!-- Kısa özet -->
            <UniformGrid x:Name="Stats" Columns="4" Margin="0,34,0,0" />

            <!-- Son 7 gün -->
            <TextBlock Text="SON 7 GÜN" Style="{StaticResource Caption}" Opacity="0.85" Margin="0,34,0,14" />
            <UniformGrid x:Name="Week" Columns="7" />

            <TextBlock x:Name="Footer" Style="{StaticResource Muted}" Margin="0,30,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
